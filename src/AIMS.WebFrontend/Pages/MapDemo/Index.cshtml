@page
@model AIMS.WebFrontend.Pages.MapDemo.IndexModel
@{
    ViewData["Title"] = "Map Demo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-map-location-dot"></i> Map Demo</h1>
    <small class="text-muted">QGIS Server &mdash; world.qgs</small>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-map"></i> Interactive Map</h6>
        <small id="map-status" class="text-muted">Loading layers&hellip;</small>
    </div>
    <div class="card-body p-0">
        <div id="map" style="height: 600px; width: 100%;"></div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const QGIS_SERVER = 'http://159.223.33.82/qgisserver';
        const MAP_PROJECT = '/home/qgis/projects/world.qgs';

        const map = L.map('map').setView([1.0, 114.7], 5);
        const statusEl = document.getElementById('map-status');

        const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const baseLayers = { 'OpenStreetMap': osm };

        function addWmsLayer(layers) {
            const wms = L.tileLayer.wms(QGIS_SERVER, {
                MAP: MAP_PROJECT,
                layers: layers,
                format: 'image/png',
                transparent: true,
                version: '1.3.0',
                attribution: 'QGIS Server'
            });

            L.control.layers(baseLayers, { 'QGIS WMS': wms }, { collapsed: false }).addTo(map);

            statusEl.textContent = 'Layers: ' + layers;
            statusEl.classList.replace('text-muted', 'text-success');
        }

        const capsUrl = QGIS_SERVER
            + '?MAP=' + encodeURIComponent(MAP_PROJECT)
            + '&SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities';

        fetch(capsUrl)
            .then(r => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(xml => {
                const doc = new DOMParser().parseFromString(xml, 'text/xml');
                if (doc.querySelector('parsererror')) throw new Error('Bad XML');

                // getElementsByTagNameNS('*', ...) is namespace-safe (handles wms: prefix)
                const layerEls = Array.from(doc.getElementsByTagNameNS('*', 'Layer'));
                const seen = new Set();
                const names = [];
                for (const layer of layerEls) {
                    for (const child of layer.children) {
                        if (child.localName === 'Name') {
                            const name = child.textContent.trim();
                            if (name && !seen.has(name)) {
                                seen.add(name);
                                names.push(name);
                            }
                            break;
                        }
                    }
                }

                addWmsLayer(names.length ? names.join(',') : 'world');
            })
            .catch(() => {
                addWmsLayer('world');
                statusEl.textContent = 'Auto-discovery unavailable, using default layer';
                statusEl.classList.replace('text-muted', 'text-warning');
            });
    </script>
}
