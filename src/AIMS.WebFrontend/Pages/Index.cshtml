@page
@model IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}

<div class="sims-d-flex sims-align-center sims-justify-between sims-mb-4">
    <div>
        <h3 style="margin:0"><i class="fas fa-industry sims-me-2"></i>Badak NGL</h3>
        <span class="sims-text-sm sims-text-muted">Structural Integrity Management System</span>
    </div>
    <span class="sims-badge sims-badge-blue">Rev A / 20260701</span>
</div>

<!-- Site Map -->
<div class="sims-card">
    <div class="sims-card-header">
        <i class="fas fa-map-location-dot"></i> Site Map
        <small id="map-status" class="sims-text-sm sims-text-muted ms-auto">Loading layers&hellip;</small>
    </div>
    <div class="sims-card-body" style="padding:0">
        <div id="map" style="height: 500px; width: 100%;"
             data-qgis-server="@Model.QgisBrowserUrl"
             data-map-project="@Model.MapProject"
             data-base-layer="Citra Satelite"
             data-init-lat="0.08744" data-init-lng="117.48562" data-init-zoom="16"
             data-search-terms='["Plan 17"]'></div>
    </div>
</div>
@section RightPanel {
    <div class="sims-panel-resizer" id="rightPanelResizer" title="Drag to resize"></div>
    <aside class="sims-panel-right" id="rightPanel">
        <div class="sims-panel-right-header">
            <i class="fas fa-circle-info sims-me-2"></i> Summary
        </div>
        <div class="sims-panel-right-scroll" id="rightPanelContent">
            <div class="sims-card-header" style="padding-left:0">
                <i class="fas fa-chart-pie"></i> Plant Summary
            </div>
            @if (Model.TotalAssets > 0)
            {
                <div class="sims-mb-2">
                    <select id="plantFilter" class="sims-form-control sims-form-select" style="width:100%">
                        <option value="all">All Plant</option>
                        @for (var i = 1; i < Model.PlantConditionSummaries.Count; i++)
                        {
                            <option value="@i">@Model.PlantConditionSummaries[i].PlantName</option>
                        }
                    </select>
                </div>
            }
            @if (Model.TotalAssets == 0)
            {
                <p class="sims-text-muted">No assets recorded.</p>
            }
            else
            {
                <canvas id="plantSummaryChart" height="180"></canvas>
            }

            <div class="sims-card-header" style="padding-left:0;border-top:1px solid var(--sims-border);margin-top:16px">
                <i class="fas fa-heart-pulse"></i> Condition Breakdown &ndash; All Plant
            </div>
            @if (Model.TotalAssets == 0)
            {
                <p class="sims-text-muted">No assets recorded.</p>
            }
            else
            {
                var unknownCount = Model.TotalAssets - Model.GoodStatusCount - Model.FairStatusCount - Model.PoorStatusCount;
                <div class="sims-mb-3">
                    <div class="sims-d-flex sims-justify-between sims-mb-1">
                        <span><span class="condition-dot good"></span> Good</span>
                        <span class="sims-fw-bold">@Model.GoodStatusCount</span>
                    </div>
                    <div class="sims-progress">
                        <div class="sims-progress-bar green" style="width:@(Model.GoodStatusCount * 100 / Model.TotalAssets)%"></div>
                    </div>
                </div>
                <div class="sims-mb-3">
                    <div class="sims-d-flex sims-justify-between sims-mb-1">
                        <span><span class="condition-dot fair"></span> Fair</span>
                        <span class="sims-fw-bold">@Model.FairStatusCount</span>
                    </div>
                    <div class="sims-progress">
                        <div class="sims-progress-bar amber" style="width:@(Model.FairStatusCount * 100 / Model.TotalAssets)%"></div>
                    </div>
                </div>
                <div class="sims-mb-3">
                    <div class="sims-d-flex sims-justify-between sims-mb-1">
                        <span><span class="condition-dot poor"></span> Poor</span>
                        <span class="sims-fw-bold">@Model.PoorStatusCount</span>
                    </div>
                    <div class="sims-progress">
                        <div class="sims-progress-bar red" style="width:@(Model.PoorStatusCount * 100 / Model.TotalAssets)%"></div>
                    </div>
                </div>
                <div>
                    <div class="sims-d-flex sims-justify-between sims-mb-1">
                        <span><span class="condition-dot unknown"></span> Unknown</span>
                        <span class="sims-fw-bold">@unknownCount</span>
                    </div>
                    <div class="sims-progress">
                        <div class="sims-progress-bar gray" style="width:@(unknownCount * 100 / Model.TotalAssets)%"></div>
                    </div>
                </div>
            }
        </div>
    </aside>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_SiteMapScripts"); }

    @if (Model.TotalAssets > 0)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js"></script>
        <script>
            (function () {
                // Index 0 = the "All Plant" aggregate; 1..N = one entry per plant.
                const summaries = @Html.Raw(JsonSerializer.Serialize(Model.PlantConditionSummaries.Select(p => new {
                    name = p.PlantName,
                    good = p.Good,
                    fair = p.Fair,
                    poor = p.Poor,
                    unknown = p.Unknown
                })));

                function labelsFor(set) { return set.map(s => s.name); }
                function column(set, key) { return set.map(s => s[key]); }

                // Default view = "All Plant" aggregate (single bar group), not one bar per plant.
                const initial = summaries.slice(0, 1);
                const chart = new Chart(document.getElementById('plantSummaryChart'), {
                    type: 'bar',
                    data: {
                        labels: labelsFor(initial),
                        datasets: [
                            { label: 'Good', data: column(initial, 'good'), backgroundColor: '#92d050' },
                            { label: 'Fair', data: column(initial, 'fair'), backgroundColor: '#e6b800' },
                            { label: 'Poor', data: column(initial, 'poor'), backgroundColor: '#ff0000' },
                            { label: 'Unknown', data: column(initial, 'unknown'), backgroundColor: '#6b7280' }
                        ]
                    },
                    options: {
                        responsive: true,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        },
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });

                function applyFilter() {
                    const sel = document.getElementById('plantFilter').value;
                    // "All Plant" shows the site-wide aggregate as a single bar group,
                    // same shape as a specific plant (which shows just that plant's bar).
                    const set = (sel === 'all') ? [summaries[0]] : [summaries[parseInt(sel, 10)]];

                    chart.data.labels = labelsFor(set);
                    chart.data.datasets[0].data = column(set, 'good');
                    chart.data.datasets[1].data = column(set, 'fair');
                    chart.data.datasets[2].data = column(set, 'poor');
                    chart.data.datasets[3].data = column(set, 'unknown');
                    chart.update();

                    // Condition Breakdown below stays as the All Plant aggregate — the
                    // filter is scoped to the histogram only, per the dashboard design.
                }

                document.getElementById('plantFilter').addEventListener('change', applyFilter);
            })();
        </script>
    }
}