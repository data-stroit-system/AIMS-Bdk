@page
@model IndexModel
@using AIMS.Core.Entities
@{
    ViewData["Title"] = "Dashboard";
}

<div class="sims-d-flex sims-align-center sims-justify-between sims-mb-4">
    <div>
        <h3 style="margin:0"><i class="fas fa-industry sims-me-2"></i>Badak NGL</h3>
        <span class="sims-text-sm sims-text-muted">Structural Integrity Management System</span>
    </div>
    <span class="sims-badge sims-badge-blue">Rev A / 20260701</span>
</div>

<!-- Stat Cards -->
<div class="sims-stat-grid">
    <div class="sims-stat-card">
        <div class="sims-stat-card-icon blue"><i class="fas fa-boxes-stacked"></i></div>
        <div>
            <div class="sims-stat-card-value">@Model.TotalAssets</div>
            <div class="sims-stat-card-label">Total Assets</div>
        </div>
    </div>
    <div class="sims-stat-card">
        <div class="sims-stat-card-icon red"><i class="fas fa-triangle-exclamation"></i></div>
        <div>
            <div class="sims-stat-card-value">@Model.HighPriorityCount</div>
            <div class="sims-stat-card-label">High Priority</div>
        </div>
    </div>
    <div class="sims-stat-card">
        <div class="sims-stat-card-icon amber"><i class="fas fa-circle-half-stroke"></i></div>
        <div>
            <div class="sims-stat-card-value">@Model.FairStatusCount</div>
            <div class="sims-stat-card-label">Fair Integrity</div>
        </div>
    </div>
    <div class="sims-stat-card">
        <div class="sims-stat-card-icon red"><i class="fas fa-circle-xmark"></i></div>
        <div>
            <div class="sims-stat-card-value">@Model.PoorStatusCount</div>
            <div class="sims-stat-card-label">Poor Integrity</div>
        </div>
    </div>
</div>

<!-- Plant Summary + Breakdown -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="sims-card">
            <div class="sims-card-header">
                <i class="fas fa-chart-pie"></i> Plant Summary
            </div>
            <div class="sims-card-body">
                @if (Model.TotalAssets == 0)
                {
                    <p class="sims-text-muted">No assets recorded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="sims-table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Count</th>
                                    <th>Distribution</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="condition-dot good"></span> Good</td>
                                    <td class="sims-fw-bold">@Model.GoodStatusCount</td>
                                    <td>
                                        <div class="sims-d-flex sims-align-center sims-gap-2">
                                            <div class="sims-progress sims-w-100">
                                                <div class="sims-progress-bar green" style="width:@(Model.TotalAssets > 0 ? (Model.GoodStatusCount * 100 / Model.TotalAssets) : 0)%"></div>
                                            </div>
                                            <span class="sims-text-sm sims-text-muted">@(Model.TotalAssets > 0 ? (Model.GoodStatusCount * 100 / Model.TotalAssets) : 0)%</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><span class="condition-dot fair"></span> Fair</td>
                                    <td class="sims-fw-bold">@Model.FairStatusCount</td>
                                    <td>
                                        <div class="sims-d-flex sims-align-center sims-gap-2">
                                            <div class="sims-progress sims-w-100">
                                                <div class="sims-progress-bar amber" style="width:@(Model.TotalAssets > 0 ? (Model.FairStatusCount * 100 / Model.TotalAssets) : 0)%"></div>
                                            </div>
                                            <span class="sims-text-sm sims-text-muted">@(Model.TotalAssets > 0 ? (Model.FairStatusCount * 100 / Model.TotalAssets) : 0)%</span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><span class="condition-dot poor"></span> Poor</td>
                                    <td class="sims-fw-bold">@Model.PoorStatusCount</td>
                                    <td>
                                        <div class="sims-d-flex sims-align-center sims-gap-2">
                                            <div class="sims-progress sims-w-100">
                                                <div class="sims-progress-bar red" style="width:@(Model.TotalAssets > 0 ? (Model.PoorStatusCount * 100 / Model.TotalAssets) : 0)%"></div>
                                            </div>
                                            <span class="sims-text-sm sims-text-muted">@(Model.TotalAssets > 0 ? (Model.PoorStatusCount * 100 / Model.TotalAssets) : 0)%</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sims-card">
            <div class="sims-card-header">
                <i class="fas fa-flag"></i> Priority Breakdown
            </div>
            <div class="sims-card-body">
                @if (Model.TotalAssets == 0)
                {
                    <p class="sims-text-muted">No assets recorded.</p>
                }
                else
                {
                    <div class="sims-mb-3">
                        <div class="sims-d-flex sims-justify-between sims-mb-1">
                            <span><span class="condition-dot poor"></span> High</span>
                            <span class="sims-fw-bold">@Model.HighPriorityCount</span>
                        </div>
                        <div class="sims-progress">
                            <div class="sims-progress-bar red" style="width:@(Model.TotalAssets > 0 ? (Model.HighPriorityCount * 100 / Model.TotalAssets) : 0)%"></div>
                        </div>
                    </div>
                    <div class="sims-mb-3">
                        <div class="sims-d-flex sims-justify-between sims-mb-1">
                            <span><span class="condition-dot fair"></span> Medium</span>
                            <span class="sims-fw-bold">@Model.MediumPriorityCount</span>
                        </div>
                        <div class="sims-progress">
                            <div class="sims-progress-bar amber" style="width:@(Model.TotalAssets > 0 ? (Model.MediumPriorityCount * 100 / Model.TotalAssets) : 0)%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="sims-d-flex sims-justify-between sims-mb-1">
                            <span><span class="condition-dot good"></span> Low</span>
                            <span class="sims-fw-bold">@Model.LowPriorityCount</span>
                        </div>
                        <div class="sims-progress">
                            <div class="sims-progress-bar green" style="width:@(Model.TotalAssets > 0 ? (Model.LowPriorityCount * 100 / Model.TotalAssets) : 0)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="sims-card">
            <div class="sims-card-header">
                <i class="fas fa-layer-group"></i> Asset Types
            </div>
            <div class="sims-card-body">
                @if (Model.TotalAssets == 0)
                {
                    <p class="sims-text-muted">No assets recorded.</p>
                }
                else
                {
                    @foreach (AssetType type in Enum.GetValues(typeof(AssetType)))
                    {
                        var count = Model.AssetsByType.GetValueOrDefault(type, 0);
                        <div class="sims-d-flex sims-justify-between sims-align-center py-2 @(type != AssetType.Other ? "border-bottom" : "")">
                            <a asp-page="/AssetItems/Index" asp-route-typeFilter="@type" class="sims-text-sm text-decoration-none">@type</a>
                            <span class="sims-badge sims-badge-sky">@count</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Assets -->
<div class="sims-card">
    <div class="sims-card-header">
        <i class="fas fa-clock-rotate-left"></i> Recently Added Assets
        <a asp-page="/AssetItems/Index" class="sims-btn sims-btn-outline sims-btn-sm ms-auto">View All</a>
    </div>
    <div class="sims-card-body" style="padding:0">
        @if (!Model.RecentAssets.Any())
        {
            <div class="p-3 sims-text-muted"><i class="fas fa-circle-info"></i> No assets have been added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="sims-table">
                    <thead>
                        <tr>
                            <th>Asset ID</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Integrity</th>
                            <th>Location</th>
                            <th>Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentAssets)
                        {
                            <tr>
                                <td><a asp-page="/AssetItems/Details" asp-route-id="@item.Id"><code>@item.AssetId</code></a></td>
                                <td><a asp-page="/AssetItems/Details" asp-route-id="@item.Id">@item.Title</a></td>
                                <td><span class="sims-badge sims-badge-sky">@item.Type</span></td>
                                <td>
                                    @if (item.Priority == AssetPriority.High)
                                    { <span class="sims-badge sims-badge-red">@item.Priority</span> }
                                    else if (item.Priority == AssetPriority.Medium)
                                    { <span class="sims-badge sims-badge-amber">@item.Priority</span> }
                                    else
                                    { <span class="sims-badge sims-badge-green">@item.Priority</span> }
                                </td>
                                <td>
                                    @if (item.IntegrityStatus == IntegrityStatus.Good)
                                    { <span class="sims-badge sims-badge-green">@item.IntegrityStatus</span> }
                                    else if (item.IntegrityStatus == IntegrityStatus.Fair)
                                    { <span class="sims-badge sims-badge-amber">@item.IntegrityStatus</span> }
                                    else
                                    { <span class="sims-badge sims-badge-red">@item.IntegrityStatus</span> }
                                </td>
                                <td class="sims-text-sm">@item.Location</td>
                                <td class="sims-text-sm sims-text-muted">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
