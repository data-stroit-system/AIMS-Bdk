<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    (function () {
        const mapEl = document.getElementById('map');
        if (!mapEl) return;

        // Everything page-specific comes from data attributes on the #map div:
        // qgis-server/map-project (required), feature-info ("true" enables click
        // popups and the post-zoom popup), base-layer (optional WMS base layer
        // name), init-lat/init-lng/init-zoom (initial view), search-terms (JSON
        // array auto-searched once layers load).
        const QGIS_SERVER = mapEl.dataset.qgisServer;
        const MAP_PROJECT = mapEl.dataset.mapProject;
        const featureInfoEnabled = mapEl.dataset.featureInfo === 'true';
        const baseLayerName = mapEl.dataset.baseLayer || null;
        const initLat = parseFloat(mapEl.dataset.initLat) || 0.131;
        const initLng = parseFloat(mapEl.dataset.initLng) || 117.472;
        const initZoom = parseInt(mapEl.dataset.initZoom, 10) || 14;
        let searchTerms = null;
        try {
            searchTerms = mapEl.dataset.searchTerms ? JSON.parse(mapEl.dataset.searchTerms) : null;
        } catch (e) {
            searchTerms = null;
        }
        // Asset tag for the live point lookup (server-side WFS query by tag).
        // Plant code/name let the server resolve the plant group's point layer.
        const assetTag = mapEl.dataset.assetTag || null;
        const plantCode = mapEl.dataset.plantCode || null;
        const plantName = mapEl.dataset.plantName || null;

        const map = L.map('map', { maxZoom: 25 }).setView([initLat, initLng], initZoom);
        const statusEl = document.getElementById('map-status');

        const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const controlBaseLayers = { 'OpenStreetMap': osm };

        let currentLayers = '';
        // layer name → {minx, miny, maxx, maxy} from GetCapabilities BoundingBox
        const layerExtents = {};

        function setStatus(text, cssClass) {
            if (!statusEl) return;
            statusEl.textContent = text;
            statusEl.classList.remove('sims-text-muted', 'text-muted', 'text-success', 'text-warning');
            statusEl.classList.add(cssClass);
        }

        function showFeatureInfo(latlng, layers) {
            const popup = L.popup().setLatLng(latlng).setContent('<em>Loading&hellip;</em>').openOn(map);

            const size = map.getSize();
            const bounds = map.getBounds();
            const sw = bounds.getSouthWest();
            const ne = bounds.getNorthEast();
            const bbox = `${sw.lat},${sw.lng},${ne.lat},${ne.lng}`;
            const pt = map.latLngToContainerPoint(latlng);

            const url = `?handler=FeatureInfo`
                + `&layers=${encodeURIComponent(layers)}`
                + `&bbox=${encodeURIComponent(bbox)}`
                + `&width=${size.x}&height=${size.y}`
                + `&i=${Math.round(pt.x)}&j=${Math.round(pt.y)}`;

            fetch(url)
                .then(r => r.text())
                .then(text => {
                    const trimmed = text.trim();
                    popup.setContent(trimmed
                        ? `<pre style="max-height:200px;overflow:auto;margin:0;font-size:11px;white-space:pre-wrap">${trimmed}</pre>`
                        : '<em>No feature info at this location.</em>');
                })
                .catch(() => popup.setContent('<em>Feature info unavailable.</em>'));
        }

        function addWmsLayers(layerNames) {
            // Overlay list = every layer except the base layer and its group's
            // children (requesting a group as base already renders them).
            let overlayNames = layerNames.map(l => l.name);
            let baseLayerIdx = -1;
            if (baseLayerName) {
                for (let i = 0; i < layerNames.length; i++) {
                    if (layerNames[i].name === baseLayerName) {
                        baseLayerIdx = i;
                        const baseDepth = layerNames[i].depth;
                        let j = i + 1;
                        while (j < layerNames.length && layerNames[j].depth > baseDepth) j++;
                        overlayNames = layerNames.slice(0, i).map(l => l.name)
                            .concat(layerNames.slice(j).map(l => l.name));
                        break;
                    }
                }
            }

            // All layers for feature-info lookup
            currentLayers = layerNames.map(l => l.name);

            if (baseLayerIdx !== -1) {
                controlBaseLayers[baseLayerName] = L.tileLayer.wms(QGIS_SERVER, {
                    MAP: MAP_PROJECT,
                    layers: baseLayerName,
                    format: 'image/png',
                    transparent: false,
                    version: '1.3.0',
                    maxZoom: 25,
                    attribution: 'QGIS Server'
                }).addTo(map);
            }

            const overlays = {};
            overlayNames.forEach((name, i) => {
                overlays[name] = L.tileLayer.wms(QGIS_SERVER, {
                    MAP: MAP_PROJECT,
                    layers: name,
                    format: 'image/png',
                    transparent: true,
                    version: '1.3.0',
                    maxZoom: 25,
                    attribution: 'QGIS Server',
                    zIndex: overlayNames.length - i,
                    opacity: name === 'Luas Area Pelatihan' ? 0.4 : 0.6
                });
            });

            const overlayKeys = Object.keys(overlays);
            overlayKeys.forEach(name => overlays[name].addTo(map));

            L.control.layers(controlBaseLayers, overlays, { collapsed: false, autoZIndex: false }).addTo(map);

            const allVisible = baseLayerIdx !== -1
                ? [baseLayerName, ...overlayKeys]
                : overlayKeys;
            setStatus('Layers: ' + (allVisible.join(', ') || 'none'), 'text-success');
        }

        if (featureInfoEnabled) {
            map.on('click', function (e) {
                showFeatureInfo(e.latlng, currentLayers);
            });
        }

        function zoomToLayer(match) {
            // Zoom 2× at current center, then open feature info popup at the center
            const center = map.getCenter();
            const targetZoom = Math.min(map.getZoom() + 2, map.getMaxZoom());
            map.setView(center, targetZoom, { animate: true });

            if (featureInfoEnabled) {
                map.once('moveend', function () {
                    showFeatureInfo(center, match);
                });
            }
        }

        // Live-lookup of the asset's center point: the page resolves the asset
        // tag to a point on the QGIS point layer (WFS, server-side). On a hit,
        // drop a marker and zoom to it; otherwise fall back to layer search.
        function locateAssetPoint(tag, fallbackTerms) {
            let url = '?handler=AssetPoint&tag=' + encodeURIComponent(tag);
            if (plantCode) url += '&plantCode=' + encodeURIComponent(plantCode);
            if (plantName) url += '&plantName=' + encodeURIComponent(plantName);
            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (data && data.found && !isNaN(data.lat) && !isNaN(data.lng)) {
                        const latlng = L.latLng(data.lat, data.lng);
                        L.marker(latlng).addTo(map)
                            .bindPopup('<strong>' + (data.name || tag) + '</strong>')
                            .openPopup();
                        map.setView(latlng, 18, { animate: true });
                        setStatus('Asset point: ' + (data.name || tag), 'text-success');
                    } else if (fallbackTerms && fallbackTerms.length) {
                        doSearch(fallbackTerms);
                    } else {
                        setStatus('No point found for asset "' + tag + '"', 'text-warning');
                    }
                })
                .catch(() => {
                    if (fallbackTerms && fallbackTerms.length) doSearch(fallbackTerms);
                });
        }

        // First candidate term that substring-matches a layer name wins.
        // Spaces in the term are also tried as underscores ("Plant 17" → "Plant_17").
        function doSearch(terms) {
            for (const t of terms) {
                const q = String(t).trim().toLowerCase();
                if (!q) continue;
                const qUnderscored = q.replace(/\s+/g, '_');

                const match = currentLayers.find(function (name) {
                    const lower = name.toLowerCase();
                    if (lower.indexOf(q) !== -1) return true;
                    return qUnderscored !== q && lower.indexOf(qUnderscored) !== -1;
                });

                if (match) {
                    setStatus('Found layer "' + match + '"', 'text-success');
                    zoomToLayer(match);
                    return;
                }
            }
            setStatus('No matching layer for "' + terms.join('", "') + '".', 'text-warning');
        }

        const capsUrl = QGIS_SERVER
            + '?MAP=' + encodeURIComponent(MAP_PROJECT)
            + '&SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities';

        fetch(capsUrl)
            .then(r => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(xml => {
                const doc = new DOMParser().parseFromString(xml, 'text/xml');
                if (doc.querySelector('parsererror')) throw new Error('Bad XML');

                // getElementsByTagNameNS('*', ...) is namespace-safe (handles wms: prefix)
                const layerEls = Array.from(doc.getElementsByTagNameNS('*', 'Layer'));
                const seen = new Set();
                const names = [];
                for (const layer of layerEls) {
                    let layerName = null;
                    let bbox = null;
                    for (const child of layer.children) {
                        if (child.localName === 'Name' && !layerName) {
                            layerName = child.textContent.trim();
                        }
                        // WMS 1.3.0: BoundingBox, 1.1.1: LatLonBoundingBox
                        if ((child.localName === 'BoundingBox' || child.localName === 'LatLonBoundingBox') && !bbox) {
                            const minx = parseFloat(child.getAttribute('minx'));
                            const miny = parseFloat(child.getAttribute('miny'));
                            const maxx = parseFloat(child.getAttribute('maxx'));
                            const maxy = parseFloat(child.getAttribute('maxy'));
                            if (!isNaN(minx) && !isNaN(miny) && !isNaN(maxx) && !isNaN(maxy)) {
                                bbox = { minx, miny, maxx, maxy };
                            }
                        }
                    }
                    if (layerName && !seen.has(layerName)) {
                        seen.add(layerName);
                        let depth = 0;
                        for (let p = layer.parentElement; p; p = p.parentElement) {
                            if (p.localName === 'Layer') depth++;
                        }
                        names.push({ name: layerName, depth });
                        if (bbox) layerExtents[layerName] = bbox;
                    }
                }
                console.log('Discovered WMS layers:', names.map(l => l.name), 'with extents:', Object.keys(layerExtents));
                addWmsLayers(names);

                if (assetTag) {
                    locateAssetPoint(assetTag, searchTerms);
                } else if (searchTerms && searchTerms.length) {
                    doSearch(searchTerms);
                }
            })
            .catch(() => {
                addWmsLayers(['world']);
                setStatus('Auto-discovery unavailable, using default layer', 'text-warning');
            });
    })();
</script>
