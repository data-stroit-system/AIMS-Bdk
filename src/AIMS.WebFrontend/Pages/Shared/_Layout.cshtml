@using AIMS.Infrastructure.IdentityClass
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Top Bar -->
        <header class="sims-topbar">
            <div class="sims-d-flex sims-align-center sims-gap-2">
                <button class="sims-hamburger" id="toggleSidebar" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <a asp-page="/Index" class="sims-topbar-brand">
                    <i class="fas fa-shield-halved"></i> SIMS
                </a>
            </div>
            <div class="sims-topbar-right">
                <span class="sims-text-sm sims-text-muted">@User.Identity?.Name</span>
                <div class="dropdown">
                    <button class="btn btn-link dropdown-toggle sims-text-sm" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text fw-bold">@User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-page="/Account/Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Shell: 3-panel layout -->
        <div class="sims-shell">
            <!-- Left: Asset Tree -->
            <aside class="sims-panel-left" id="mainSidebar">
                <div class="sims-panel-left-header">
                    <i class="fas fa-sitemap sims-me-2"></i> Asset Tree
                </div>
                <div class="sims-panel-left-scroll" id="assetTree">
                    <!-- Plants loaded dynamically or server-rendered -->
                    <ul class="sims-tree-list">
                        <li class="sims-tree-item">
                            <a class="sims-tree-link active" asp-page="/Index">
                                <span class="sims-tree-icon"><i class="fas fa-tachometer-alt"></i></span>
                                <span class="sims-tree-label">Dashboard</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="sims-tree-item">
                                <a class="sims-tree-link @(Context.Request.Path.StartsWithSegments("/AssetItems") ? "active" : "")"
                                   asp-page="/AssetItems/Index">
                                    <span class="sims-tree-icon"><i class="fas fa-boxes-stacked"></i></span>
                                    <span class="sims-tree-label">Assets</span>
                                </a>
                            </li>
                            <li class="sims-tree-item">
                                <a class="sims-tree-link" asp-page="/MapDemo/Index">
                                    <span class="sims-tree-icon"><i class="fas fa-map-location-dot"></i></span>
                                    <span class="sims-tree-label">Map Demo</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="sims-tree-item">
                                <a class="sims-tree-link collapsed"
                                   data-bs-toggle="collapse" href="#adminSubmenu" role="button">
                                    <span class="sims-tree-icon"><i class="fas fa-user-shield"></i></span>
                                    <span class="sims-tree-label">Administration</span>
                                    <i class="fas fa-chevron-down ms-auto"></i>
                                </a>
                                <ul class="sims-tree-children collapse" id="adminSubmenu">
                                    <li><a class="sims-tree-link" asp-page="/Admin/Users/Index">User Management</a></li>
                                    <li><a class="sims-tree-link" asp-page="/Admin/Roles/Index">Role Management</a></li>
                                    <li><a class="sims-tree-link" asp-page="/Admin/AuditLogs">Audit Trail</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Manager"))
                        {
                            <li class="sims-tree-item">
                                <a class="sims-tree-link collapsed"
                                   data-bs-toggle="collapse" href="#mgmtSubmenu" role="button">
                                    <span class="sims-tree-icon"><i class="fas fa-users-gear"></i></span>
                                    <span class="sims-tree-label">Management</span>
                                    <i class="fas fa-chevron-down ms-auto"></i>
                                </a>
                                <ul class="sims-tree-children collapse" id="mgmtSubmenu">
                                    <li><a class="sims-tree-link" asp-page="/Admin/Users/Index">View Users</a></li>
                                    <li><a class="sims-tree-link" asp-page="/Admin/AuditLogs">Audit Trail</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("User"))
                        {
                            <li class="sims-tree-item">
                                <a class="sims-tree-link" asp-page="/Admin/AuditLogs">
                                    <span class="sims-tree-icon"><i class="fas fa-clipboard-list"></i></span>
                                    <span class="sims-tree-label">My Audit Trail</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="sims-panel-right-header" style="border-top:1px solid #2d3140">
                    <i class="fas fa-user sims-me-2"></i> @(User.Identity?.Name ?? "Guest")
                </div>
            </aside>

            <!-- Overlay for mobile sidebar -->
            <div class="sims-overlay" id="sidebarOverlay"></div>

            <!-- Center Content -->
            <main class="sims-panel-center" id="mainContent">
                <div class="sims-content-body">
                    @RenderBody()
                </div>
            </main>

            <!-- Right Panel: context summary (optional, hidden by default) -->
            <aside class="sims-panel-right" id="rightPanel">
                <div class="sims-panel-right-header">
                    <i class="fas fa-circle-info sims-me-2"></i> Summary
                </div>
                <div class="sims-panel-right-scroll" id="rightPanelContent">
                    <p class="sims-text-sm sims-text-muted">Select an asset to view details.</p>
                </div>
            </aside>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(function() {
            const sidebar = $('#mainSidebar');
            const overlay = $('#sidebarOverlay');
            const rightPanel = $('#rightPanel');

            $('#toggleSidebar').on('click', function() {
                sidebar.toggleClass('mobile-show');
                overlay.toggleClass('show');
            });

            overlay.on('click', function() {
                sidebar.removeClass('mobile-show');
                overlay.removeClass('show');
                rightPanel.removeClass('mobile-show');
            });

            function highlightActiveLink() {
                const path = window.location.pathname.toLowerCase();
                $('#mainSidebar .sims-tree-link').each(function() {
                    const $link = $(this);
                    const href = ($link.attr('href') || '').toLowerCase();
                    if (href && path.startsWith(href) && href !== '#') {
                        $link.addClass('active');
                        $link.closest('.sims-tree-children').addClass('show');
                    }
                });
            }
            highlightActiveLink();

            $(document).on('click', '.sims-tree-link[data-bs-toggle="collapse"]', function() {
                const $icon = $(this).find('.fa-chevron-down');
                $icon.toggleClass('rotated');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
