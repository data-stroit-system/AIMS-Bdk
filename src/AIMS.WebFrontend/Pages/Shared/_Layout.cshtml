@using AIMS.Infrastructure.IdentityClass
@using AIMS.Infrastructure.Services
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager
@inject PlantService PlantService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Top Bar -->
        <header class="sims-topbar">
            <div class="sims-topbar-left">
                <button class="sims-hamburger" id="toggleSidebar" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <a asp-page="/Index" class="sims-topbar-brand">
                <img src="~/asset-pictures/badak-lng-large.png" alt="Badak LNG" />
                <span>Structural Integrity Management System (SIMS)</span>
            </a>
            <div class="sims-topbar-right">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <nav class="sims-topbar-nav">
                        <a class="sims-topbar-nav-btn @(Context.Request.Path.StartsWithSegments("/AssetReg") ? "active" : "")" asp-page="/AssetReg/Index">
                            <i class="fas fa-table-list"></i> <span class="sims-nav-label">Asset Register</span>
                        </a>
                        <a class="sims-topbar-nav-btn @(Context.Request.Path.StartsWithSegments("/MapDemo") ? "active" : "")" asp-page="/MapDemo/Index">
                            <i class="fas fa-map-location-dot"></i> <span class="sims-nav-label">Map Demo</span>
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="dropdown">
                                <button class="sims-topbar-nav-btn dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-shield"></i> <span class="sims-nav-label">System</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Admin/Users/Index">User Management</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/AuditLogs">Audit Trail</a></li>
                                </ul>
                            </div>
                        }
                        else if (User.IsInRole("Manager"))
                        {
                            <div class="dropdown">
                                <button class="sims-topbar-nav-btn dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="fas fa-users-gear"></i> <span class="sims-nav-label">Management</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Admin/Users/Index">View Users</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/AuditLogs">Audit Trail</a></li>
                                </ul>
                            </div>
                        }
                        else if (User.IsInRole("User"))
                        {
                            <a class="sims-topbar-nav-btn @(Context.Request.Path.StartsWithSegments("/Admin/AuditLogs") ? "active" : "")" asp-page="/Admin/AuditLogs">
                                <i class="fas fa-clipboard-list"></i> <span class="sims-nav-label">My Audit Trail</span>
                            </a>
                        }
                    </nav>
                }
                <span class="sims-text-sm sims-text-muted sims-topbar-username">@User.Identity?.Name</span>
                <div class="dropdown">
                    <button class="btn btn-link dropdown-toggle sims-text-sm" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text fw-bold">@User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-page="/Account/Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Shell: 3-panel layout -->
        <div class="sims-shell">
            <!-- Left: Asset Tree -->
            <aside class="sims-panel-left" id="mainSidebar">
                <div class="sims-panel-left-header sims-d-flex sims-align-center sims-justify-between">
                    <span><i class="fas fa-sitemap sims-me-2"></i> Asset Tree</span>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-page="/Plants/Index" title="Manage plants" style="color:inherit">
                            <i class="fas fa-gear"></i>
                        </a>
                    }
                </div>
                <div class="sims-panel-left-scroll" id="assetTree">
                    <!-- Plants loaded dynamically or server-rendered -->
                    <ul class="sims-tree-list">
                        <li class="sims-tree-item">
                            <a class="sims-tree-link active" asp-page="/Index">
                                <span class="sims-tree-icon"><i class="fas fa-tachometer-alt"></i></span>
                                <span class="sims-tree-label">Dashboard</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            @* <li class="sims-tree-item">
                                <a class="sims-tree-link @(Context.Request.Path.StartsWithSegments("/AssetItems") ? "active" : "")"
                                   asp-page="/AssetItems/Index">
                                    <span class="sims-tree-icon"><i class="fas fa-boxes-stacked"></i></span>
                                    <span class="sims-tree-label">Assets</span>
                                </a>
                            </li> *@
                          
                            // Slide-4 asset tree: flat plant list, the plant being viewed is
                            // expanded server-side with its asset tags and an "+ add asset" link.
                            var plantTreeNodes = await PlantService.GetTreeAsync();
                            var canManagePlants = User.IsInRole("Admin") || User.IsInRole("Manager");
                            int? selectedPlantId = int.TryParse(Context.Request.Query["plantId"], out var qPlantId) ? qPlantId : null;
                            int? currentAssetId = int.TryParse(Context.Request.Query["assetId"], out var qAssetId) ? qAssetId : null;
                            var detailsMatch = System.Text.RegularExpressions.Regex.Match(
                                Context.Request.Path.Value ?? string.Empty,
                                "/AssetItems/Details/(\\d+)",
                                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            if (detailsMatch.Success)
                            {
                                currentAssetId = int.Parse(detailsMatch.Groups[1].Value);
                            }
                            if (currentAssetId.HasValue)
                            {
                                selectedPlantId ??= plantTreeNodes
                                    .SelectMany(n => n.Assets)
                                    .FirstOrDefault(a => a.Id == currentAssetId)?.PlantId;
                            }
                            foreach (var node in plantTreeNodes)
                            {
                                var isSelected = node.Plant.Id == selectedPlantId;
                                <li class="sims-tree-item">
                                    <a class="sims-tree-link @(isSelected ? "plant-selected" : "")"
                                       asp-page="/AssetItems/Index" asp-route-plantId="@node.Plant.Id"
                                       title="@node.Plant.Code @node.Plant.Description">
                                        <i class="fas fa-chevron-right sims-tree-chevron @(isSelected ? "expanded" : "")"></i>
                                        <span class="sims-tree-label">@node.Plant.Name</span>
                                    </a>
                                    @if (isSelected)
                                    {
                                        <ul class="sims-tree-children show">
                                            @foreach (var asset in node.Assets)
                                            {
                                                <li>
                                                    <a class="sims-tree-link @(asset.Id == currentAssetId ? "plant-selected" : "")"
                                                       asp-page="/AssetItems/Index" asp-route-plantId="@node.Plant.Id" asp-route-assetId="@asset.Id" title="@asset.Title">
                                                        <span class="sims-tree-label">@asset.AssetId</span>
                                                    </a>
                                                </li>
                                            }
                                            @if (canManagePlants)
                                            {
                                                <li>
                                                    <a class="sims-tree-add d-block" style="text-decoration:none"
                                                       asp-page="/AssetItems/Create" asp-route-plantId="@node.Plant.Id">+ add asset</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                            if (canManagePlants)
                            {
                                <li class="sims-tree-item">
                                    <a class="sims-tree-add d-block" style="text-decoration:none;padding-left:16px"
                                       asp-page="/Plants/Create">+ add Plant</a>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div class="sims-panel-right-header" style="border-top:1px solid #2d3140">
                    <i class="fas fa-user sims-me-2"></i> @(User.Identity?.Name ?? "Guest")
                </div>
            </aside>

            <!-- Overlay for mobile sidebar -->
            <div class="sims-overlay" id="sidebarOverlay"></div>

            <!-- Center Content -->
            <main class="sims-panel-center" id="mainContent">
                <div class="sims-content-body">
                    @RenderBody()
                </div>
            </main>

            <!-- Right Panel: context summary (optional, hidden by default) -->
            @RenderSection("RightPanel", required: false)
            
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(function() {
            const sidebar = $('#mainSidebar');
            const overlay = $('#sidebarOverlay');
            const rightPanel = $('#rightPanel');

            $('#toggleSidebar').on('click', function() {
                sidebar.toggleClass('mobile-show');
                overlay.toggleClass('show');
            });

            overlay.on('click', function() {
                sidebar.removeClass('mobile-show');
                overlay.removeClass('show');
                rightPanel.removeClass('mobile-show');
            });

            function highlightActiveLink() {
                const path = window.location.pathname.toLowerCase();
                $('#mainSidebar .sims-tree-link').each(function() {
                    const $link = $(this);
                    const href = ($link.attr('href') || '').toLowerCase();
                    if (href && path.startsWith(href) && href !== '#') {
                        $link.addClass('active');
                        $link.closest('.sims-tree-children').addClass('show');
                    }
                });
            }
            highlightActiveLink();

            $(document).on('click', '.sims-tree-link[data-bs-toggle="collapse"]', function() {
                const $icon = $(this).find('.fa-chevron-down');
                $icon.toggleClass('rotated');
            });

            // Drag-to-resize for the right panel, when present on the page.
            const resizer = document.getElementById('rightPanelResizer');
            const panel = document.querySelector('.sims-panel-right');
            if (resizer && panel) {
                const MIN_WIDTH = 240;
                const MAX_WIDTH = 560;
                let startX = 0;
                let startWidth = 0;

                function onMouseMove(e) {
                    const newWidth = Math.min(MAX_WIDTH, Math.max(MIN_WIDTH, startWidth + (startX - e.clientX)));
                    panel.style.width = newWidth + 'px';
                    panel.style.minWidth = newWidth + 'px';
                }
                function stopResize() {
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', stopResize);
                    resizer.classList.remove('is-resizing');
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                }
                resizer.addEventListener('mousedown', function (e) {
                    startX = e.clientX;
                    startWidth = panel.getBoundingClientRect().width;
                    resizer.classList.add('is-resizing');
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', stopResize);
                    e.preventDefault();
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
