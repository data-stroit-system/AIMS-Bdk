@page
@model AIMS.WebFrontend.Pages.AssetItems.IndexModel
@using AIMS.Core.Entities
@using AIMS.WebFrontend.Models
@{
    ViewData["Title"] = "Asset Items";
}

<div class="@(Model.FilterPlant != null ? "d-flex flex-column h-100" : "")">
<div class="sims-d-flex sims-align-center sims-justify-between sims-mb-4">
    <div>
        <h3 style="margin:0"><i class="fas fa-boxes-stacked sims-me-2"></i>Asset Items</h3>
        @if (Model.FilterPlant != null)
        {
            <span class="sims-text-sm sims-text-muted">
                Plant: <span class="sims-badge sims-badge-sky">@Model.FilterPlant.Name</span>
                <a asp-page="Index" class="ms-1" title="Show all assets">&times;</a>
            </span>
        }
        else
        {
            <span class="sims-text-sm sims-text-muted">Manage structural integrity assets</span>
        }
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-page="Create" class="sims-btn sims-btn-primary sims-btn-lg">
            <i class="fas fa-circle-plus"></i> Add New Asset
        </a>
    }
</div>

@if (Model.FilterPlant != null)
{
    <!-- Plant Map -->
    <div class="sims-card sims-mb-4 flex-grow-1 d-flex flex-column" style="min-height: 0;">
        <div class="sims-card-header flex-shrink-0">
            <i class="fas fa-map-location-dot"></i> Site Map
            <small id="map-status" class="sims-text-sm sims-text-muted ms-auto">Loading layers&hellip;</small>
        </div>
        <div class="sims-card-body flex-grow-1" style="padding:0; min-height: 0;">
            <div id="map" style="height: 100%; width: 100%;"
                 data-qgis-server="@Model.QgisBrowserUrl"
                 data-map-project="@Model.MapProject"
                 data-feature-info="true"
                 data-base-layer="Citra Satelite"
                 data-init-lat="0.08744" data-init-lng="117.48562" data-init-zoom="16"
                 data-asset-tag="@Model.SelectedAsset?.AssetId"
                 data-plant-code="@Model.FilterPlant?.Code"
                 data-plant-name="@Model.FilterPlant?.Name"
                 data-search-terms="@Model.SearchTermsJson"></div>
        </div>
    </div>
}
</div>

@section RightPanel {
    @if (Model.SelectedAsset != null)
    {
        await Html.RenderPartialAsync("_AssetSummary", new AssetSummaryViewModel { Asset = Model.SelectedAsset, Plant = Model.FilterPlant });
    }
    else if (Model.FilterPlant != null)
    {
        <div class="sims-panel-resizer" id="rightPanelResizer" title="Drag to resize"></div>
        <aside class="sims-panel-right" id="rightPanel">
            <div class="sims-panel-right-header">
                <i class="fas fa-circle-info sims-me-2"></i> Plant Info
            </div>
            <div class="sims-panel-right-scroll">
                <div class="sims-mb-3">
                    <div class="sims-text-xs sims-text-muted">Plant Code</div>
                    <div class="sims-fw-bold">@Model.FilterPlant.Code</div>
                </div>
                <div>
                    <div class="sims-text-xs sims-text-muted">Plant Desc.</div>
                    <div class="sims-fw-bold">@Model.FilterPlant.Description</div>
                </div>
            </div>
        </aside>
    }
}


@if (!Model.PlantId.HasValue && !Model.AssetId.HasValue)
{
    <!-- Search & Filter -->
    <div class="sims-card">
    <div class="sims-card-header">
        <i class="fas fa-filter"></i> Search & Filter
    </div>
    <div class="sims-card-body">
        <form method="get" id="filterForm">
            @if (Model.PlantId.HasValue)
            {
                <input type="hidden" name="plantId" value="@Model.PlantId" />
            }
            <div class="row g-3">
                <div class="col-md-12">
                    <label for="searchTerm" class="sims-form-label">Search</label>
                    <div class="sims-d-flex sims-gap-2">
                        <input type="text" id="searchTerm" name="searchTerm" class="sims-form-control"
                               placeholder="Search by Asset ID or Title..."
                               value="@Model.SearchTerm" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="statusFilter" class="sims-form-label">Condition</label>
                    <select id="statusFilter" name="statusFilter" class="sims-form-control sims-form-select">
                        <option value="">All Conditions</option>
                        @foreach (var status in new[] { "Good", "Fair", "Poor" })
                        {
                            <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                        }
                    </select>
                </div>
            </div>
            <div class="sims-d-flex sims-gap-2 sims-mt-3">
                <button type="submit" class="sims-btn sims-btn-primary">
                    <i class="fas fa-magnifying-glass"></i> Apply Filters
                </button>
                <a asp-page="Index" class="sims-btn sims-btn-outline">
                    <i class="fas fa-rotate-left"></i> Clear
                </a>
            </div>
        </form>

        @{
            var hasActiveFilters = !string.IsNullOrEmpty(Model.SearchTerm) ||
                                 !string.IsNullOrEmpty(Model.StatusFilter);
        }
        @if (hasActiveFilters)
        {
            <div class="sims-mt-3 pt-3 border-top">
                <small class="sims-fw-bold sims-text-muted">Active Filters:</small>
                <div class="sims-mt-2 sims-d-flex sims-gap-2 flex-wrap">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <span class="sims-badge sims-badge-blue">
                            Search: @Model.SearchTerm
                            <a href="@Url.Page("Index", new { statusFilter = Model.StatusFilter })" class="ms-1">&times;</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <span class="sims-badge sims-badge-blue">
                            Status: @Model.StatusFilter
                            <a href="@Url.Page("Index", new { searchTerm = Model.SearchTerm })" class="ms-1">&times;</a>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
</div>

    <!-- Asset List -->
    <div class="sims-card">
    <div class="sims-card-header">
        <i class="fas fa-list"></i> Asset Items List
        @if (Model.AssetItems.Any())
        {
            <span class="sims-badge sims-badge-gray ms-2">@Model.AssetItems.Count result(s)</span>
        }
    </div>
    <div class="sims-card-body" style="padding:0">
        @if (!Model.AssetItems.Any())
        {
            <div class="p-4 sims-text-muted">
                <i class="fas fa-circle-info"></i> No asset items found.
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-page="Create">Create one now</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="sims-table">
                    <thead>
                        <tr>
                            <th style="width:48px"></th>
                            <th>Asset Tag No.</th>
                            <th>Title</th>
                            <th>Plant</th>
                            <th>Asset Code</th>
                            <th>Condition</th>
                            <th>Area</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AssetItems)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PicturePath))
                                    {
                                        <a asp-page="Details" asp-route-id="@item.Id">
                                            <img src="@item.PicturePath" alt="@item.Title" style="width:36px;height:36px;object-fit:cover;border-radius:4px;" />
                                        </a>
                                    }
                                </td>
                                <td><a asp-page="Details" asp-route-id="@item.Id"><code>@item.AssetId</code></a></td>
                                <td><a asp-page="Details" asp-route-id="@item.Id">@item.Title</a></td>
                                <td class="sims-text-sm">
                                    @{ var itemPlant = item.PlantId.HasValue ? Model.PlantsById.GetValueOrDefault(item.PlantId.Value) : null; }
                                    <span class="sims-badge sims-badge-sky">@itemPlant?.Code</span>
                                    @itemPlant?.Description
                                </td>
                                <td class="sims-text-sm">
                                    <span class="sims-badge sims-badge-gray">@item.AssetCode</span>
                                </td>
                                <td>
                                    @{
                                        var condBadge = "sims-badge-gray";
                                        if (!string.IsNullOrEmpty(item.Condition))
                                        {
                                            condBadge = item.Condition.Equals("Good", StringComparison.OrdinalIgnoreCase) ? "sims-badge-green"
                                                : item.Condition.Equals("Fair", StringComparison.OrdinalIgnoreCase) ? "sims-badge-amber"
                                                : item.Condition.Equals("Poor", StringComparison.OrdinalIgnoreCase) ? "sims-badge-red" : "sims-badge-gray";
                                            <span class="sims-badge @condBadge">@item.Condition</span>
                                        }
                                        else
                                        {
                                            <span class="sims-text-xs sims-text-muted">-</span>
                                        }
                                    }
                                </td>
                                <td class="sims-text-sm">@item.Area</td>
                                <td>
                                    <div class="sims-d-flex sims-gap-2">
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-page="Edit" asp-route-id="@item.Id" class="sims-btn sims-btn-outline sims-btn-sm" title="Edit">
                                                <i class="fas fa-pencil"></i>
                                            </a>
                                            <button type="button" class="sims-btn sims-btn-danger sims-btn-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@item.Id.ToString().Replace("-","")"
                                                    title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="sims-text-xs sims-text-muted">View only</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                // 'page' is a reserved Razor Pages route value, so asp-route-page
                // cannot generate the ?page= query — build the href manually.
                var filterQuery = "searchTerm=" + Uri.EscapeDataString(Model.SearchTerm ?? "")
                    + "&statusFilter=" + Uri.EscapeDataString(Model.StatusFilter ?? "")
                    + "&plantId=" + (Model.PlantId?.ToString() ?? "")
                    + "&assetId=" + (Model.AssetId?.ToString() ?? "");
                <div class="p-3 border-top sims-d-flex sims-align-center sims-justify-between">
                    <small class="sims-text-muted">Page @Model.CurrentPage of @Model.TotalPages</small>
                    <div class="sims-d-flex sims-gap-2">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="sims-btn sims-btn-outline sims-btn-sm" href="?page=1&amp;@filterQuery">
                                <i class="fas fa-angles-left"></i>
                            </a>
                            <a class="sims-btn sims-btn-outline sims-btn-sm" href="?page=@(Model.CurrentPage - 1)&amp;@filterQuery">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a class="sims-btn @(i == Model.CurrentPage ? "sims-btn-primary" : "sims-btn-outline") sims-btn-sm"
                               href="?page=@i&amp;@filterQuery">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="sims-btn sims-btn-outline sims-btn-sm" href="?page=@(Model.CurrentPage + 1)&amp;@filterQuery">
                                <i class="fas fa-angle-right"></i>
                            </a>
                            <a class="sims-btn sims-btn-outline sims-btn-sm" href="?page=@Model.TotalPages&amp;@filterQuery">
                                <i class="fas fa-angles-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
    </div>

    <!-- Delete Modals -->
    @foreach (var item in Model.AssetItems)
    {
        <div class="modal fade" id="deleteModal-@item.Id.ToString().Replace("-","")" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        Delete asset <strong>@item.Title</strong> (ID: @item.AssetId)?
                        <br /><span class="sims-text-sm sims-badge sims-badge-red sims-mt-2">This cannot be undone.</span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="sims-btn sims-btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" asp-page="Delete" asp-route-id="@item.Id" style="display:inline">
                            <button type="submit" class="sims-btn sims-btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    @if (Model.FilterPlant != null)
    {
        await Html.RenderPartialAsync("_SiteMapScripts");
    }
}
