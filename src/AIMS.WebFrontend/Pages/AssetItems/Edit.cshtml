@page "{id:int}"
@model AIMS.WebFrontend.Pages.AssetItems.EditModel
@using AIMS.Core.Entities
@{
    ViewData["Title"] = "Edit Asset";
}

<a asp-page="Index" class="sims-btn sims-btn-outline sims-mb-3">
    <i class="fas fa-arrow-left"></i> Back to Assets
</a>

<div class="sims-d-flex sims-align-center sims-justify-between sims-mb-3">
    <h3 style="margin:0"><i class="fas fa-pencil sims-me-2"></i>Edit Asset Item</h3>
    <code>@Model.CurrentAssetId</code>
</div>

<div class="sims-card">
    <div class="sims-card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Section: Asset Register -->
            <h6 class="sims-text-sm sims-text-muted sims-mb-3" style="text-transform:uppercase;letter-spacing:.5px;">
                <i class="fas fa-clipboard-list sims-me-2"></i>Asset Register
            </h6>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.PlantId" class="sims-form-label">Plant <span class="required">*</span></label>
                        <select asp-for="Input.PlantId" class="sims-form-control sims-form-select">
                            <option value="">&lt;Plant selection&gt;</option>
                            @foreach (var plant in Model.Plants)
                            {
                                <option value="@plant.Id" data-code="@plant.Code">@plant.Code - @plant.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.PlantId" class="d-block mt-1 text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.GisRefNo" class="sims-form-label">GIS Ref. No.</label>
                        <input asp-for="Input.GisRefNo" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label class="sims-form-label">Asset Tag No. <span class="sims-form-hint">(auto generated)</span></label>
                        <input id="assetTagPreview" class="sims-form-control" readonly value="@Model.CurrentAssetId" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Title" class="sims-form-label">Asset Description <span class="required">*</span></label>
                        <input asp-for="Input.Title" class="sims-form-control" />
                        <span asp-validation-for="Input.Title" class="d-block mt-1 text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.EquipmentCode" class="sims-form-label">Equipment Code <span class="required">*</span></label>
                        <select asp-for="Input.EquipmentCode" class="sims-form-control sims-form-select">
                            @foreach (var ec in EquipmentCode.All)
                            { <option value="@ec.Code">@ec.Code - @ec.Description</option> }
                        </select>
                        <span asp-validation-for="Input.EquipmentCode" class="d-block mt-1 text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.EquipmentDesc" class="sims-form-label">Equipment Desc.</label>
                        <input asp-for="Input.EquipmentDesc" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.EquipmentOrder" class="sims-form-label">Equip. Order</label>
                        <input asp-for="Input.EquipmentOrder" type="number" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.CivilAssetCode" class="sims-form-label">Civil Code <span class="required">*</span></label>
                        <select asp-for="Input.CivilAssetCode" class="sims-form-control sims-form-select">
                            @foreach (var cc in CivilAssetCode.All)
                            { <option value="@cc.Code">@cc.Code - @cc.Description</option> }
                        </select>
                        <span asp-validation-for="Input.CivilAssetCode" class="d-block mt-1 text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.CivilAssetOrder" class="sims-form-label">Civil Order</label>
                        <input asp-for="Input.CivilAssetOrder" type="number" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="sims-form-group">
                        <label asp-for="Input.CivilAssetDesc" class="sims-form-label">Civil Asset Desc.</label>
                        <input asp-for="Input.CivilAssetDesc" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="sims-form-group">
                        <label asp-for="Input.QrCode" class="sims-form-label">QR Code</label>
                        <input asp-for="Input.QrCode" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <hr class="sims-mt-2">
            <!-- Section: Asset Attribute -->
            <h6 class="sims-text-sm sims-text-muted sims-mb-3" style="text-transform:uppercase;letter-spacing:.5px;">
                <i class="fas fa-cubes sims-me-2"></i>Asset Attribute
            </h6>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Function" class="sims-form-label">Function</label>
                        <input asp-for="Input.Function" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Material" class="sims-form-label">Material</label>
                        <input asp-for="Input.Material" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.YearInstalled" class="sims-form-label">Year Installed</label>
                        <input asp-for="Input.YearInstalled" type="number" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Owner" class="sims-form-label">Owner</label>
                        <input asp-for="Input.Owner" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Access" class="sims-form-label">Access</label>
                        <input asp-for="Input.Access" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Constrain" class="sims-form-label">Constrain</label>
                        <input asp-for="Input.Constrain" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <hr class="sims-mt-2">
            <!-- Section: Location -->
            <h6 class="sims-text-sm sims-text-muted sims-mb-3" style="text-transform:uppercase;letter-spacing:.5px;">
                <i class="fas fa-location-dot sims-me-2"></i>Location
            </h6>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.CoordinateN" class="sims-form-label">Coordinate N</label>
                        <input asp-for="Input.CoordinateN" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.CoordinateE" class="sims-form-label">Coordinate E</label>
                        <input asp-for="Input.CoordinateE" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Zone" class="sims-form-label">Zone</label>
                        <input asp-for="Input.Zone" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Area" class="sims-form-label">Area</label>
                        <input asp-for="Input.Area" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Train" class="sims-form-label">Train</label>
                        <input asp-for="Input.Train" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <hr class="sims-mt-2">
            <!-- Section: Condition (GVI) -->
            <h6 class="sims-text-sm sims-text-muted sims-mb-3" style="text-transform:uppercase;letter-spacing:.5px;">
                <i class="fas fa-clipboard-check sims-me-2"></i>Condition (GVI) &amp; Inspection
            </h6>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.DateOfInspection" class="sims-form-label">Date of Inspection</label>
                        <input asp-for="Input.DateOfInspection" type="date" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Inspector" class="sims-form-label">Inspector</label>
                        <input asp-for="Input.Inspector" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Condition" class="sims-form-label">Condition</label>
                        <select asp-for="Input.Condition" class="sims-form-control sims-form-select">
                            <option value="">&lt;Condition Selection&gt;</option>
                            <option value="Good">Good</option>
                            <option value="Fair">Fair</option>
                            <option value="Poor">Poor</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="sims-form-group">
                        <label asp-for="Input.Comment" class="sims-form-label">Comment</label>
                        <input asp-for="Input.Comment" class="sims-form-control" />
                    </div>
                </div>
            </div>

            <hr class="sims-mt-2">
            <!-- Section: Additional -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Location" class="sims-form-label">Location (legacy)</label>
                        <input asp-for="Input.Location" class="sims-form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="sims-form-group">
                        <label asp-for="Input.Description" class="sims-form-label">Description (legacy)</label>
                        <textarea asp-for="Input.Description" class="sims-form-control sims-form-textarea" rows="1"></textarea>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Type" class="sims-form-label">Asset Type</label>
                        <select asp-for="Input.Type" class="sims-form-control sims-form-select">
                            <option value="">-- Select --</option>
                            @foreach (AssetType t in Enum.GetValues(typeof(AssetType)))
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.Priority" class="sims-form-label">Priority</label>
                        <select asp-for="Input.Priority" class="sims-form-control sims-form-select">
                            <option value="">-- Select --</option>
                            @foreach (AssetPriority p in Enum.GetValues(typeof(AssetPriority)))
                            { <option value="@p">@p</option> }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="sims-form-group">
                        <label asp-for="Input.IntegrityStatus" class="sims-form-label">Integrity Status</label>
                        <select asp-for="Input.IntegrityStatus" class="sims-form-control sims-form-select">
                            <option value="">-- Select --</option>
                            @foreach (IntegrityStatus s in Enum.GetValues(typeof(IntegrityStatus)))
                            { <option value="@s">@s</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="sims-form-group">
                        <label asp-for="Input.Picture" class="sims-form-label">Picture</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingPicturePath))
                        {
                            <div class="sims-mb-2">
                                <img src="@Model.ExistingPicturePath" alt="Current" style="max-height:80px;border-radius:4px;border:1px solid #e5e7eb;" />
                                <span class="sims-form-hint">Upload a new file to replace.</span>
                            </div>
                        }
                        <input asp-for="Input.Picture" type="file" class="sims-form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                        <span class="sims-form-hint">JPG, PNG, GIF, WebP &mdash; max 2 MB</span>
                    </div>
                </div>
            </div>

            <div class="sims-d-flex sims-gap-2 sims-mt-3">
                <button type="submit" class="sims-btn sims-btn-primary"><i class="fas fa-save"></i> Save</button>
                <a asp-page="Index" class="sims-btn sims-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function() {
            function updateAssetId() {
                var pc = $('#Input_PlantId option:selected').data('code') || '';
                var ec = $('#Input_EquipmentCode').val() || '';
                var eo = $('#Input_EquipmentOrder').val() || '';
                var cc = $('#Input_CivilAssetCode').val() || '';
                var co = $('#Input_CivilAssetOrder').val() || '';
                $('#assetTagPreview').val(pc + ec + '-' + eo + '/' + cc + '-' + co);
            }
            // Only recompute the preview once the user actually changes a field —
            // until then, keep showing the persisted Asset Tag No.
            $('#Input_PlantId, #Input_EquipmentCode, #Input_EquipmentOrder, #Input_CivilAssetCode, #Input_CivilAssetOrder').on('change input', updateAssetId);
        });
    </script>
}
