# One config file, two consumers:
#   - upload.sh runs on your DEV MACHINE and reads the "Upload" section
#     below to zip + scp the repo to the server.
#   - deploy.sh runs ON THE SERVER (in an SSH session, after upload.sh has
#     put the code there) and reads everything else.
# Copy this file to deploy/deploy.conf (both locally and on the server —
# they can have different values) and edit as needed. deploy.conf is
# gitignored and sourced by both scripts — do not commit it.

# --- Upload (used by upload.sh only) ---
REMOTE_HOST="deli@192.168.0.8"   # user@host
REMOTE_SSH_PORT=22
REMOTE_SSH_KEY=""                 # path to a private key, or leave empty for ssh-agent/default
REMOTE_DIR="AIMS-Bdk"             # path on the server (relative to home, or absolute) to extract into

# --- Layout ---
APP_USER="aims"           # system user the app runs as (created if missing)
BASE_DIR="/opt/aims"      # releases/, shared/, current -> live under here
KEEP_RELEASES=5           # how many old releases to retain for rollback

# --- App runtime ---
SERVICE_NAME="aims-webfrontend"
APP_PORT=5000              # Kestrel listens on 127.0.0.1:$APP_PORT, nginx proxies to it
DOTNET_CHANNEL="10.0"      # ASP.NET Core runtime channel to install on the server

# --- Nginx ---
SERVER_NAME="_"            # nginx server_name; "_" = catch-all (use a hostname/IP if you have one) — ignored in TLS mode (DOMAIN set)
NGINX_LISTEN_PORT=80       # external port nginx listens on (e.g. 81 in prod) — set here, don't hand-edit the generated nginx site file, deploy.sh overwrites it every run. In TLS mode this legacy port just 301s to https.
NGINX_CLIENT_MAX_BODY_SIZE="50m"

# --- TLS / Let's Encrypt (optional) ---
# Set DOMAIN to serve the site over https with a Let's Encrypt cert (needed for
# the phone camera on /Scanner — getUserMedia requires a secure context).
# deploy.sh then writes an nginx config with three servers: NGINX_HTTP_PORT
# (serves ACME challenges from /var/www/letsencrypt, redirects everything else
# to https), the legacy NGINX_LISTEN_PORT (redirects to https), and 443 (TLS,
# written only once a cert exists at TLS_CERT_FILE).
# Bring-up with a fresh domain (A record -> server public IP, port 80 open):
#   1. run deploy.sh
#   2. sudo certbot certonly --webroot -w /var/www/letsencrypt -d "$DOMAIN" \
#        --email "$ACME_EMAIL" --agree-tos --no-eff-email --non-interactive
#   3. run deploy.sh again        (443 block appears once the cert exists)
# Leave DOMAIN empty for the current plain-HTTP setup.
DOMAIN=""                          # e.g. "sims.example.com" — A record -> server public IP
ACME_EMAIL=""                      # Let's Encrypt expiry notices (needed for the one-time issuance)
# TLS_CERT_FILE="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"   # defaults; uncomment only to relocate
# TLS_KEY_FILE="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
NGINX_HTTP_PORT=80                 # HTTP port for ACME challenges + https redirect
HSTS_MAX_AGE=15552000              # Strict-Transport-Security max-age in seconds (6 months)
QGIS_PROXY_TARGET="http://127.0.0.1:8081"   # internal QGIS server (after it vacates port 80); nginx proxies /qgisserver -> here

# --- Build ---
CSPROJ_PATH="src/AIMS.WebFrontend/AIMS.WebFrontend.csproj"
BUILD_CONFIGURATION="Release"

# --- QGIS Server (injected into appsettings.Production.json by deploy.sh) ---
QGIS_SERVER_URL="http://192.168.0.8/qgisserver"   # browser-facing URL the map JS uses. In TLS mode set to "/qgisserver" (same-origin via nginx) so WMS tiles aren't mixed content on https.
QGIS_MAP_PROJECT="/home/deli/OrthoProject1/OrthoProject1.qgs"

# --- DB backup/restore (used by db_backup.sh and db_backup_sqlplus.sh) ---
BACKUP_DIR="$BASE_DIR/backups"   # where .dmp/.sql backup files land
KEEP_BACKUPS=7                   # how many backups to retain
APPSETTINGS_FILE="$BASE_DIR/shared/appsettings.Production.json"   # app config whose ConnectionStrings:Oracle is used
ORACLE_CONTAINER_NAME="oracle-xe-11g"                    # must match setup_oracle_xe.sh
ORACLE_OS_USER="oracle"                                  # native Oracle only: OS user that owns the install
ORACLE_HOME="/u01/app/oracle/product/11.2.0/xe"           # native and container mode
ORACLE_SID="XE"                                           # native and container mode
