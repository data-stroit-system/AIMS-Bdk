# One config file, two consumers:
#   - upload.sh runs on your DEV MACHINE and reads the "Upload" section
#     below to zip + scp the repo to the server.
#   - deploy.sh runs ON THE SERVER (in an SSH session, after upload.sh has
#     put the code there) and reads everything else.
# Copy this file to deploy/deploy.conf (both locally and on the server —
# they can have different values) and edit as needed. deploy.conf is
# gitignored and sourced by both scripts — do not commit it.

# --- Upload (used by upload.sh only) ---
REMOTE_HOST="deli@159.223.33.82"   # user@host
REMOTE_SSH_PORT=22
REMOTE_SSH_KEY=""                 # path to a private key, or leave empty for ssh-agent/default
REMOTE_DIR="AIMS-Bdk"             # path on the server (relative to home, or absolute) to extract into

# --- Layout ---
APP_USER="aims"           # system user the app runs as (created if missing)
BASE_DIR="/opt/aims"      # releases/, shared/, current -> live under here
KEEP_RELEASES=5           # how many old releases to retain for rollback

# --- App runtime ---
SERVICE_NAME="aims-webfrontend"
APP_PORT=5000              # Kestrel listens on 127.0.0.1:$APP_PORT, nginx proxies to it
DOTNET_CHANNEL="10.0"      # ASP.NET Core runtime channel to install on the server

# --- Nginx ---
SERVER_NAME="_"            # nginx server_name; "_" = catch-all (use a hostname like dtp.devtim.my.id otherwise)
NGINX_LISTEN_PORT=80       # external port nginx listens on when SSL is OFF (e.g. 81 in prod) — set here, don't hand-edit the generated nginx site file, deploy.sh overwrites it every run
NGINX_CLIENT_MAX_BODY_SIZE="50m"

# --- TLS / Cloudflare (optional) —
# To host behind the Cloudflare proxy (orange-cloud) at https://<SERVER_NAME>:
#   1. In the Cloudflare dashboard: SSL/TLS → Origin Server → Create Certificate
#      (RSA, 15 years, host *.devtim.my.id and devtim.my.id). Copy the cert to
#      NGINX_SSL_CERT and the key to NGINX_SSL_KEY (chmod 600 the key).
#   2. SSL/TLS → Edge Certificates → "Always Use HTTPS" = On.
#   3. SSL/TLS → Overview → Encryption mode = Full (strict).
#   4. DNS: A record for dtp.devtim.my.id → your server IP, Proxied (orange cloud).
#   5. Set NGINX_ENABLE_SSL="true" and SERVER_NAME="dtp.devtim.my.id" here,
#      rerun deploy.sh. The app (Program.cs) re-enables UseHttpsRedirection +
#      UseHsts now that nginx forwards X-Forwarded-Proto=https; nginx also
#      301-redirects :80 → :443 so the app never sees a plaintext request.
NGINX_ENABLE_SSL="false"
NGINX_SSL_CERT="/etc/ssl/cloudflare/dtp.devtim.my.id.pem"
NGINX_SSL_KEY="/etc/ssl/cloudflare/dtp.devtim.my.id.key"
NGINX_REDIRECT_HTTP_TO_HTTPS="true"   # emit a :80 → :443 301 block (set false to drop :80 entirely)

# --- Build ---
CSPROJ_PATH="src/AIMS.WebFrontend/AIMS.WebFrontend.csproj"
BUILD_CONFIGURATION="Release"

# --- QGIS Server (injected into appsettings.Production.json by deploy.sh) ---
# QGIS_SERVER_URL is the upstream QGIS Server the app talks to server-side
# (FeatureInfo proxy via HttpClient) AND the target nginx proxies /qgisserver
# to. Must be reachable from the prod box (HTTP is fine — it's server-to-server).
QGIS_SERVER_URL="http://159.223.33.82:8081/qgisserver"
QGIS_MAP_PROJECT="/home/qgis/projects/ProjectPelatihan/Ortho Project_QGS.qgs"
# Browser-facing QGIS path. nginx proxies /qgisserver → $QGIS_SERVER_URL, so
# setting this to "/qgisserver" makes the browser talk same-origin to nginx
# (HTTPS when NGINX_ENABLE_SSL=true) which forwards to the upstream over
# plain HTTP internally — avoiding "mixed content" blocking on an HTTPS
# page. Leave empty in dev (no nginx in front of `dotnet run` → browser
# falls back to QGIS_SERVER_URL directly).
QGIS_BROWSER_URL="/qgisserver"

# --- DB backup/restore (used by db_backup.sh and db_backup_sqlplus.sh) ---
BACKUP_DIR="$BASE_DIR/backups"   # where .dmp/.sql backup files land
KEEP_BACKUPS=7                   # how many backups to retain
APPSETTINGS_FILE="$BASE_DIR/shared/appsettings.Production.json"   # app config whose ConnectionStrings:Oracle is used
ORACLE_CONTAINER_NAME="oracle-xe-11g"                    # must match setup_oracle_xe.sh
ORACLE_OS_USER="oracle"                                  # native Oracle only: OS user that owns the install
ORACLE_HOME="/u01/app/oracle/product/11.2.0/xe"           # native and container mode
ORACLE_SID="XE"                                           # native and container mode
